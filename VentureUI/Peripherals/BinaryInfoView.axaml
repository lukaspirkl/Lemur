<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VentureUI"
             mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="450"
             x:Class="VentureUI.BinaryInfoView"
             x:DataType="vm:BinaryInfoViewModel">

    <Design.DataContext>
        <vm:BinaryInfoViewModelForPreviewer />
    </Design.DataContext>

    <StackPanel Spacing="6" Margin="8">

        <!-- No metadata message -->
        <TextBlock Text="No metadata found in the uploaded binary."
                   IsVisible="{Binding !HasMetadata}"
                   FontStyle="Italic"
                   Foreground="Gray" />

        <!-- Metadata fields -->
        <Grid IsVisible="{Binding HasMetadata}"
              ColumnDefinitions="Auto,12,*"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
              RowSpacing="6">

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Program" FontWeight="Bold" />
            <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding ProgramName}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Version" FontWeight="Bold" />
            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding ProgramVersion}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Build date" FontWeight="Bold" />
            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BuildDate}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Build type" FontWeight="Bold" />
            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding BuildType}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Board" FontWeight="Bold" />
            <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding TargetBoard}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Boot2" FontWeight="Bold" />
            <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding Boot2Name}" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="URL" FontWeight="Bold" />
            <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding ProgramUrl}"
                       TextWrapping="Wrap" />
        </Grid>

        <!-- Pin assignments -->
        <TextBlock Text="Pin assignments"
                   FontWeight="Bold"
                   IsVisible="{Binding HasMetadata}"
                   Margin="0,8,0,0" />

        <ItemsControl ItemsSource="{Binding Pins}" IsVisible="{Binding HasMetadata}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:PinInfoViewModel">
                    <Grid ColumnDefinitions="80,*" Margin="0,2">
                        <TextBlock Grid.Column="0"
                                   Text="{Binding Pins}"
                                   FontFamily="Monospace" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Label}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>
</UserControl>
