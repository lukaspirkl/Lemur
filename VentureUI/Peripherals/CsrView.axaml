<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VentureUI"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600"
             x:Class="VentureUI.CsrView"
             x:DataType="vm:CsrViewModel">

    <Design.DataContext>
        <vm:CsrViewModelForPreviewer />
    </Design.DataContext>

    <DockPanel>

        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,4,4,2" Spacing="6">
            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
        </StackPanel>

        <!-- Sub-tab per group -->
        <TabControl ItemsSource="{Binding Groups}" TabStripPlacement="Top">

            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CsrGroupViewModel">
                    <TextBlock Text="{Binding Name}" />
                </DataTemplate>
            </TabControl.ItemTemplate>

            <TabControl.ContentTemplate>
                <DataTemplate x:DataType="vm:CsrGroupViewModel">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Registers}" Margin="4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CsrEntryViewModel">

                                    <!-- One CSR block -->
                                    <Border BorderThickness="0,0,0,1"
                                            BorderBrush="{DynamicResource SystemControlForegroundBaseMediumLowBrush}"
                                            Margin="0,0,0,2" Padding="0,2,0,4">
                                        <StackPanel>

                                            <!-- Header row: name | address | raw value -->
                                            <Grid ColumnDefinitions="160,80,120,*">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Name}"
                                                           FontWeight="Bold"
                                                           FontFamily="Monospace"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Address}"
                                                           Classes="Secondary"
                                                           FontFamily="Monospace"
                                                           VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding RawValueHex}"
                                                           FontFamily="Monospace"
                                                           VerticalAlignment="Center" />
                                            </Grid>

                                            <!-- Field rows -->
                                            <ItemsControl ItemsSource="{Binding Fields}" Margin="16,2,0,0"
                                                          IsVisible="{Binding Fields.Count, Converter={x:Static vm:CountToBoolConverter.Instance}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CsrFieldViewModel">
                                                        <Grid ColumnDefinitions="144,60,60,*" Margin="0,1">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Name}"
                                                                       FontFamily="Monospace"
                                                                       Classes="Secondary" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Bits}"
                                                                       FontFamily="Monospace"
                                                                       Classes="Secondary" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding ValueHex}"
                                                                       FontFamily="Monospace" />
                                                            <TextBlock Grid.Column="3"
                                                                       Text="{Binding Interpretation}"
                                                                       Classes="Secondary"
                                                                       IsVisible="{Binding Interpretation, Converter={x:Static vm:StringNotEmptyConverter.Instance}}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <!-- Windowed IRQ registers: all windows shown immediately -->
                                            <ItemsControl ItemsSource="{Binding WindowRows}"
                                                          IsVisible="{Binding IsWindowed}"
                                                          Margin="16,4,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:WindowRowViewModel">
                                                        <Grid ColumnDefinitions="160,80,*" Margin="0,1">
                                                            <TextBlock Grid.Column="0"
                                                                       Text="{Binding Label}"
                                                                       FontFamily="Monospace"
                                                                       Classes="Secondary" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Bits}"
                                                                       FontFamily="Monospace" />
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding Value}"
                                                                       FontFamily="Monospace" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                        </StackPanel>
                                    </Border>

                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.ContentTemplate>

        </TabControl>
    </DockPanel>
</UserControl>
