<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="380" d:DesignHeight="600"
             x:Class="VentureUI.PinDevicesHelpView">

    <ScrollViewer>
        <StackPanel Spacing="12" Margin="16,12,16,16">

            <SelectableTextBlock TextWrapping="Wrap">
                Annotate pins in your firmware using a device keyword in square
                brackets to make them appear as live controls in the Devices tab.
            </SelectableTextBlock>

            <!-- Syntax -->
            <TextBlock Text="Syntax" FontWeight="Bold" Margin="0,4,0,0" />
            <TextBox IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                     FontSize="12" Padding="8"
                     Text="Name [DEVICE]&#x0a;Name [DEVICE(option)]" />

            <!-- Supported devices -->
            <TextBlock Text="Supported Devices" FontWeight="Bold" Margin="0,4,0,0" />
            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="4">
                <SelectableTextBlock Grid.Row="0" Grid.Column="0"
                                     FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                                     FontSize="12" Text="[LED]" />
                <SelectableTextBlock Grid.Row="0" Grid.Column="1"
                                     TextWrapping="Wrap"
                                     Text="LED indicator, active-high (default: green)" />

                <SelectableTextBlock Grid.Row="1" Grid.Column="0"
                                     FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                                     FontSize="12" Text="[LED(color)]" />
                <SelectableTextBlock Grid.Row="1" Grid.Column="1"
                                     TextWrapping="Wrap"
                                     Text="LED indicator with a specific color" />

                <SelectableTextBlock Grid.Row="2" Grid.Column="0"
                                     FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                                     FontSize="12" Foreground="Gray" Text="[BUTTON]" />
                <SelectableTextBlock Grid.Row="2" Grid.Column="1"
                                     TextWrapping="Wrap" Foreground="Gray"
                                     Text="Momentary push button, active-low (not yet implemented)" />

                <SelectableTextBlock Grid.Row="3" Grid.Column="0"
                                     FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                                     FontSize="12" Foreground="Gray" Text="[SWITCH]" />
                <SelectableTextBlock Grid.Row="3" Grid.Column="1"
                                     TextWrapping="Wrap" Foreground="Gray"
                                     Text="Toggle switch, active-low (not yet implemented)" />
            </Grid>

            <!-- LED colors -->
            <TextBlock Text="LED Colors" FontWeight="Bold" Margin="0,4,0,0" />
            <SelectableTextBlock TextWrapping="Wrap">
                Named colors: red, green, blue, yellow, orange, white, cyan, magenta, pink, purple
            </SelectableTextBlock>
            <SelectableTextBlock TextWrapping="Wrap">
                Hex value: #RRGGBB (e.g. #FF8800)
            </SelectableTextBlock>

            <!-- C example -->
            <TextBlock Text="Example (C / pico-sdk)" FontWeight="Bold" Margin="0,4,0,0" />
            <TextBox IsReadOnly="True" AcceptsReturn="True"
                     FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                     FontSize="12" Padding="8"
                     Text='bi_decl(bi_1pin_with_name(25, "Status [LED(orange)]"));&#x0a;bi_decl(bi_1pin_with_name(5,  "Disable blinking [SWITCH]"));&#x0a;bi_decl(bi_1pin_with_name(4,  "Up [BUTTON]"));&#x0a;bi_decl(bi_1pin_with_name(3,  "Down [BUTTON]"));' />

            <!-- Note about other pins -->
            <TextBlock Text="Other Pins" FontWeight="Bold" Margin="0,4,0,0" />
            <SelectableTextBlock TextWrapping="Wrap" Foreground="Gray">
                Pins with an unrecognized or missing keyword appear in the
                Other Pins list at the bottom of the tab with their full label intact.
            </SelectableTextBlock>

        </StackPanel>
    </ScrollViewer>

</UserControl>
