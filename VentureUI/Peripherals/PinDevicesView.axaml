<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VentureUI"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="380"
             x:Class="VentureUI.PinDevicesView"
             x:DataType="vm:PinDevicesViewModel">

    <Design.DataContext>
        <vm:PinDevicesViewModelForPreviewer />
    </Design.DataContext>

    <!-- Outer Grid lets the help button float top-right over all content -->
    <Grid>

        <StackPanel Spacing="6" Margin="8,8,32,8">

            <TextBlock Text="No pin devices defined in binary metadata."
                       IsVisible="{Binding !HasAnyPins}"
                       FontStyle="Italic"
                       Foreground="Gray" />

            <!-- LEDs -->
            <TextBlock Text="LEDs"
                       FontWeight="Bold"
                       IsVisible="{Binding HasLeds}"
                       Margin="0,0,0,2" />

            <ItemsControl ItemsSource="{Binding Leds}" IsVisible="{Binding HasLeds}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:LedViewModel">
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4">
                            <Ellipse Width="18" Height="18" Fill="{Binding LedBrush}" />
                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PinLabel}"
                                       VerticalAlignment="Center"
                                       Foreground="Gray"
                                       FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                                       FontSize="11" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Buttons -->
            <TextBlock Text="Buttons"
                       FontWeight="Bold"
                       IsVisible="{Binding HasButtons}"
                       Margin="0,8,0,2" />

            <ItemsControl ItemsSource="{Binding Buttons}" IsVisible="{Binding HasButtons}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ButtonViewModel">
                        <Grid ColumnDefinitions="80,*,Auto" Margin="0,3">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding PinLabel}"
                                       Foreground="Gray"
                                       FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Label}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,6,0" />
                            <ToggleButton Grid.Column="2"
                                          IsChecked="{Binding IsPressed, Mode=TwoWay}"
                                          Content="{Binding PressLabel}"
                                          Padding="10,4"
                                          MinWidth="70" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Switches -->
            <TextBlock Text="Switches"
                       FontWeight="Bold"
                       IsVisible="{Binding HasSwitches}"
                       Margin="0,8,0,2" />

            <ItemsControl ItemsSource="{Binding Switches}" IsVisible="{Binding HasSwitches}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SwitchViewModel">
                        <Grid ColumnDefinitions="80,*,Auto" Margin="0,3">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding PinLabel}"
                                       Foreground="Gray"
                                       FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Label}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0,0,6,0" />
                            <ToggleButton Grid.Column="2"
                                          IsChecked="{Binding IsOn, Mode=TwoWay}"
                                          Content="{Binding ToggleLabel}"
                                          Padding="10,4"
                                          MinWidth="70" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Other Pins -->
            <TextBlock Text="Other Pins"
                       FontWeight="Bold"
                       IsVisible="{Binding HasOtherPins}"
                       Margin="0,8,0,2" />

            <ItemsControl ItemsSource="{Binding OtherPins}" IsVisible="{Binding HasOtherPins}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UnrecognizedPinViewModel">
                        <Grid ColumnDefinitions="80,*" Margin="0,3">
                            <TextBlock Grid.Column="0"
                                       Text="{Binding PinLabel}"
                                       Foreground="Gray"
                                       FontFamily="Cascadia Mono,Consolas,Courier New,monospace"
                                       FontSize="11" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding Label}"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

        </StackPanel>

        <!-- Help button floats top-right -->
        <Button Content="?"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,4,4,0"
                Padding="6,2"
                ToolTip.Tip="How to define pin devices in firmware"
                Click="OnHelpClick" />

    </Grid>
</UserControl>
